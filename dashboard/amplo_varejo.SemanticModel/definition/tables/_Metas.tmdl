		lineageTag: a9222f88-41e3-4d68-89c7-10027bb77eb1

	measure 'Participação Receita' = DIVIDE([Receita_Total], CALCULATE([Receita_Total], ALLSELECTED()))
		formatString: 0.0%;-0.0%;0.0%
		displayFolder: 10 Diagnóstico
		lineageTag: 48156939-298e-4d89-8d9a-973b0fe4e07a

	measure 'Txt Resposta' =
			VAR _receita = [Receita_Total]
			VAR _ating = [Meta x Realizado %]
			RETURN
			    "A rede faturou " & "R$ " & FORMAT(_receita / 1000000, "0.00") & " Mi" & ", " & FORMAT(_ating, "0.0%") & " da meta. "
			    & "O dinheiro em jogo está em três frentes: " & "R$ " & FORMAT([Receita Perdida] / 1000000, "0.00") & " Mi" & " em pedidos cancelados, "
			    & "R$ " & FORMAT([Gap Lojas Abaixo Meta] / 1000000, "0.00") & " Mi" & " de gap em " & [Lojas Abaixo Meta] & " lojas abaixo da meta e "
			    & "R$ " & FORMAT([Excesso Estoque] / 1000000, "0.00") & " Mi" & " em estoque acima de 3 meses de cobertura."
		displayFolder: 11 Textos
		lineageTag: 9131e2b7-5e2a-4f4b-a15d-f6c2cea4ee8f

	measure 'Txt KPI Receita' = "R$ " & FORMAT([Receita_Total] / 1000000, "0.00") & " Mi"
		displayFolder: 11 Textos
