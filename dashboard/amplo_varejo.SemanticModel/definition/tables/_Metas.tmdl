	measure 'Txt Diagnostico Loja' =
			VAR _ating = [Meta x Realizado %]
			VAR _pedidos = [Pedidos vs Média]
			VAR _ticket = [Ticket vs Média]
			VAR _cancel = [Taxa Cancelamento] - [Taxa Cancelamento Rede]
			VAR _causa =
			    SWITCH(
			        TRUE(),
			        _ating >= 1, "Loja na meta: usar como referência para as outras lojas da região.",
			        _pedidos < -0.05 && _pedidos <= _ticket, "Causa dominante: baixo fluxo, com " & FORMAT(ABS(_pedidos), "0%") & " menos pedidos que a média das lojas.",
			        _ticket < -0.05, "Causa dominante: ticket baixo, " & FORMAT(ABS(_ticket), "0%") & " abaixo do ticket médio da rede.",
			        "Pedidos e ticket próximos da média: a meta pode estar acima do potencial da loja."
			    )
			VAR _agravante = IF(_cancel > 0.01, " Agravante: cancelamento " & FORMAT(_cancel * 100, "0.0") & " p.p. acima da rede.", "")
			RETURN
			    "Atingimento de " & FORMAT(_ating, "0%") & ". " & _causa & _agravante
		displayFolder: 11 Textos
		lineageTag: 284641b8-ceaa-49de-a08e-1c6a4199eb92

	measure 'Txt Acao Loja' =
			VAR _ating = [Meta x Realizado %]
			VAR _pedidos = [Pedidos vs Média]
			VAR _ticket = [Ticket vs Média]
			RETURN
			    SWITCH(
			        TRUE(),
			        _ating >= 1, "Ação: documentar as práticas da loja e replicar na região.",
			        _pedidos < -0.05 && _pedidos <= _ticket, "Ação: campanha local de atração e revisão de horário e equipe.",
			        _ticket < -0.05, "Ação: treinar a equipe em venda de maior valor e revisar o mix.",
			        "Ação: revisar a meta com a gestão regional."
			    )
		displayFolder: 11 Textos
		lineageTag: 880a796c-2900-4805-8959-bfe950897c75

	measure 'Txt Tooltip Regiao' = SELECTEDVALUE('DIM Lojas'[regiao]) & ": " & "R$ " & FORMAT([Receita_Total] / 1000000, "0.00") & " Mi" & " · " & FORMAT([Participação Receita], "0%") & " da receita"
		displayFolder: 11 Textos
		lineageTag: f785a40c-ef5e-4f01-a4b8-3cc702e89558

