		sourceColumn: Coluna 1

		annotation SummarizationSetBy = Automatic

	partition _Metas = m
		mode: import
		source =
				let
				  Origem = Table.FromRows(Json.Document(Binary.Decompress(Binary.FromText("i45WMlSKjQUA", BinaryEncoding.Base64), Compression.Deflate)), let _t = ((type nullable text) meta [Serialized.Text = true]) in type table [#"Coluna 1" = _t]),
				  #"Tipo de coluna alterado" = Table.TransformColumnTypes(Origem, {{"Coluna 1", Int64.Type}})
				in
				  #"Tipo de coluna alterado"

