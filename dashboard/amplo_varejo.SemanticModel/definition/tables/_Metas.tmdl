	measure 'Txt Excesso Estoque' = "R$ " & FORMAT([Excesso Estoque] / 1000000, "0.00") & " Mi"
		displayFolder: 11 Textos
		lineageTag: 6b700b32-6e12-41f4-a685-7bfb0a5bb350

	measure 'Txt Titulo Contexto' =
			VAR _topRegiao = TOPN(1, VALUES('DIM Lojas'[regiao]), [Receita_Total])
			VAR _topCategorias = TOPN(2, VALUES('DIM Produtos'[nome_categoria]), [Receita_Total])
			VAR _nomeRegiao = MAXX(_topRegiao, 'DIM Lojas'[regiao])
			VAR _shareRegiao = DIVIDE(CALCULATE([Receita_Total], _topRegiao), [Receita_Total])
			VAR _shareCategorias = DIVIDE(CALCULATE([Receita_Total], _topCategorias), [Receita_Total])
			VAR _nomesCategorias = CONCATENATEX(_topCategorias, 'DIM Produtos'[nome_categoria], " e ", [Receita_Total], DESC)
			VAR _categorias = _nomesCategorias & " somam " & FORMAT(_shareCategorias, "0%") & " da receita"
			RETURN
			    SWITCH(
			        TRUE(),
			        HASONEVALUE('DIM Lojas'[Loja]), _categorias & " da loja " & SELECTEDVALUE('DIM Lojas'[Loja]),
			        HASONEVALUE('DIM Lojas'[regiao]), _categorias & " do " & _nomeRegiao,
			        _categorias & ", e o " & _nomeRegiao & " sozinho gera " & FORMAT(_shareRegiao, "0%")
			    )
		displayFolder: 11 Textos
		lineageTag: 5fe980d0-c2f6-4b4e-adc3-82afb7a52b5d

	measure 'Txt Titulo Cancelamento' = "A taxa de cancelamento é " & FORMAT([Taxa Cancelamento], "0.0%") & ", " & FORMAT([Cancelamento x Meta], "0.0") & "× a meta, e custa " & "R$ " & FORMAT([Receita Perdida] / 1000000, "0.00") & " Mi"
		displayFolder: 11 Textos
		lineageTag: 8e925de8-6579-4998-936b-9ed533e43507

	measure 'Txt Titulo Lojas' = [Lojas Abaixo Meta] & " de " & [Lojas Avaliadas] & " lojas estão abaixo da meta, com gap de " & "R$ " & FORMAT([Gap Lojas Abaixo Meta] / 1000000, "0.00") & " Mi"
		displayFolder: 11 Textos
		lineageTag: fab596d4-8160-469a-992d-3c5f7484fd62

	measure 'Txt Titulo Estoque' = "R$ " & FORMAT([Excesso Estoque] / 1000000, "0.00") & " Mi" & " (" & FORMAT([Excesso Estoque %], "0%") & " do estoque) estão acima de 3 meses de cobertura"
		displayFolder: 11 Textos
		lineageTag: e5f32805-b3a2-410c-8b62-a33a704d2f3e

	measure 'Txt Titulo Loja' = "Loja " & SELECTEDVALUE('DIM Lojas'[Loja], "não selecionada") & " · " & SELECTEDVALUE('DIM Lojas'[nome_estado]) & " · " & SELECTEDVALUE('DIM Lojas'[regiao])
