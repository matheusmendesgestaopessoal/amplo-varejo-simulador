	measure 'Cor Receita Mes' =
			VAR _posicao = RANKX(ALLSELECTED('DIM Calendario'[mes], 'DIM Calendario'[Mes_Abrev]), [Receita_Total])
			RETURN IF(_posicao <= 2, "#1A6BF5", "#CFE0FF")
		displayFolder: 12 Formatação
		lineageTag: d063b61b-73ac-4728-bee7-16c941e14862

	measure 'Cor Receita Categoria' =
			VAR _limite = MINX(TOPN(2, ALLSELECTED('DIM Produtos'[nome_categoria]), [Receita_Total]), [Receita_Total])
			RETURN IF([Receita_Total] >= _limite, "#1A6BF5", "#CFE0FF")
