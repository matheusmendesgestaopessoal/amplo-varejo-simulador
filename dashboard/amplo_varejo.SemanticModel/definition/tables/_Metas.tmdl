	measure 'Txt Causa Loja' =
			VAR _ating = [Meta x Realizado %]
			VAR _pedidos = [Pedidos vs Média]
			VAR _ticket = [Ticket vs Média]
			VAR _ticketTxt = IF(ABS(_ticket) <= 0.05, "ticket próximo da média.", "ticket " & FORMAT(_ticket, "+0%;-0%") & " em relação à média.")
			VAR _pedidosTxt = IF(ABS(_pedidos) <= 0.05, "pedidos próximos da média.", "pedidos " & FORMAT(_pedidos, "+0%;-0%") & " em relação à média.")
			RETURN
			    SWITCH(
			        TRUE(),
			        _ating >= 1, "Loja na meta (" & FORMAT(_ating, "0%") & "): usar como referência para as lojas da região.",
			        _pedidos < -0.05 && _pedidos <= _ticket, "Baixo fluxo de clientes: " & FORMAT(ABS(_pedidos), "0%") & " menos pedidos que a média das lojas, com " & _ticketTxt,
			        _ticket < -0.05, "Ticket baixo: " & FORMAT(ABS(_ticket), "0%") & " abaixo do ticket médio da rede, com " & _pedidosTxt,
			        "Pedidos e ticket próximos da média, com " & FORMAT(_ating, "0%") & " da meta: a meta pode estar acima do potencial da loja."
			    )
		displayFolder: 11 Textos
		lineageTag: 46be8b03-5a91-47eb-9ea8-a32c5bbcfcdf

	measure 'Txt Agravante Loja' =
			VAR _dif = [Taxa Cancelamento] - [Taxa Cancelamento Rede]
			RETURN
			    SWITCH(
			        TRUE(),
			        _dif > 0.01, "Cancelamento " & FORMAT(_dif * 100, "0.0") & " p.p. acima da média da rede (" & FORMAT([Taxa Cancelamento Rede], "0.0%") & ").",
			        _dif < -0.01, "Cancelamento abaixo da média da rede: não pesa no resultado desta loja.",
			        "Cancelamento na média da rede: é o mesmo problema de processo das outras lojas."
			    )
		displayFolder: 11 Textos
		lineageTag: 43754369-7f24-4e19-8164-259b8ac07165

